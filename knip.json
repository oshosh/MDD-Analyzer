{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/{page,layout,error,not-found,robots,sitemap}.{ts,tsx}",
    "src/app/api/**/route.ts",
    "src/**/index.ts",
    "tests/**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "tailwindcss",
    "tailwindcss-animate",
    "tw-animate-css",
    "shadcn",
    "@eslint/eslintrc",
    "@eslint/js",
    "@next/eslint-plugin-next",
    "postcss"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off"
  }
}
